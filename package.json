  "scripts": {
    "db": "nodemon ./db",
    "build": "vite build",
    "build:downloadable": "vite build --mode downloadable",
    "build:electron": "vite build --mode electron && electron-builder",
    "build:electron:osx": "vite build --mode electron && electron-builder --mac",
    "build:electron:windows": "vite build --mode electron && electron-builder --win",
    "build:electron:linux": "vite build --mode electron && electron-builder --linux",
    "build:electron:linux:dir": "vite build --mode electron && electron-builder --linux dir",
    "test:coverage": "jest --config=jest_config/jest.config.json --coverage",
    "test": "jest --config=jest_config/jest.config.json",
    "test:unit": "jest --config=jest_config/jest.config.json --coverage",
    "test:int": "jest --config=jest_config/jest.int.config.json --coverage",
    "report-coverage": "cat ./coverage/lcov.info | coveralls",
    "updateSnapshot": "jest --config=jest_config/jest.config.json --updateSnapshot",
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "tslint": "tslint --project .",
    "tscheck": "tsc --noEmit",
    "start": "vite",
    "formatAll": "find ./common/ -name '*.ts*' | xargs prettier --write --config ./.prettierrc --config-precedence file-override",
    "prettier:diff": "prettier --write --config ./.prettierrc --list-different \"common/**/*.ts\" \"common/**/*.tsx\"",
    "update:tokens": "ts-node scripts/update-tokens",
    "postinstall": "electron-builder install-app-deps"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write --config ./.prettierrc --config-precedence file-override",
      "npm run tslint",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": ""
    }
  }
}
